{
  "schema_version": 1,
  "staging": {
    "user": "awgctl",
    "group": "awgctl",
    "uid": null,
    "gid": null,
    "root": "/var/lib/amneziawg-manager"
  },
  "operators": {
    "group": "awgctl-admin",
    "users": [],
    "enroll_sudo_invoker": true,
    "sudo_policy": "scoped-nopasswd"
  },
  "systemd": {
    "hardening": "conservative"
  },
  "network": {
    "ingress_boundary": "lightsail"
  },
  "dns": {
    "default": "cloudflare-malware"
  }
}
